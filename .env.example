# Copie o cookie de sessão da sua conta de teste. Nunca envie este arquivo ao GitHub.
RODADA_COOKIE="better-auth.session_token=COLE_O_VALOR_AQUI"
RODADA_EXPECTED_EMAIL="conta-de-teste@example.com"

# Esta seed funcionou no teste manual. Se o deploy mudar, atualize-a.
RODADA_SEED=rodada-dev
RODADA_BASE_URL=https://rodada.io

# Commit público dos dados usado pelo script que funcionou no DevTools.
RODADA_SOURCE_REF=db4239a0aa42a8c4a65c47c7eaf2f68cce17217d
